# ==================================================================
# EvoRS-Comm GPU Server Docker Image (ultra-thin)
# ==================================================================
# This image ONLY has project-specific Python deps.
# PyTorch, CANN, torch_npu, verl come from the GPU server's
# pre-installed Python environment (bind-mounted at runtime).
#
# Build on GPU server (native ARM64, fast):
#   bash scripts/build_on_gpu.sh
#
# The GPU server already has:
#   verl 0.8.0, PyTorch 2.9.0, CANN 8.5.1, Python 3.11
# We just add: pytest, PyYAML, numpy, Pillow, datasets, etc.
# ==================================================================

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8

# Chinese mirrors
RUN sed -i 's|archive.ubuntu.com|mirrors.aliyun.com|g' /etc/apt/sources.list \
    && sed -i 's|ports.ubuntu.com|mirrors.aliyun.com|g' /etc/apt/sources.list \
    && sed -i 's|security.ubuntu.com|mirrors.aliyun.com|g' /etc/apt/sources.list

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv git curl \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python

RUN pip3 config set global.index-url https://mirrors.aliyun.com/pypi/simple/ \
    && pip3 config set global.trusted-host mirrors.aliyun.com

WORKDIR /app

# Install ONLY lightweight project deps (torch/CANN come from host mount)
RUN pip3 install --no-cache-dir --upgrade pip \
    && pip3 install --no-cache-dir \
        pytest>=8 \
        PyYAML>=6 \
        numpy>=1.26 \
        Pillow>=10 \
        datasets>=2.19 \
        esdk-obs-python>=3.0 \
        rich \
        tqdm

# Code hot-mounted via volume
ENV PYTHONPATH=/app/src

CMD ["python3", "-m", "pytest", "-q", "--tb=short"]
