# ==================================================================
# EvoRS-Comm Docker Image for Ascend 910B (ARM)
# ==================================================================
# Target: ModelArts bm.npu.arm.1snt9b1
# - N × Ascend 910B NPUs
# - 24 vCPUs (ARM/aarch64)
# - 192 GiB RAM
# - CANN 8.0 + torch_npu
# ==================================================================

# Use official Ascend PyTorch image for 910B with CANN 8.5.1
# ModelArts pre-installed: verl_0.8.0-pytorch_2.9.0-cann_8.5.1-py_3.11
# For China servers, use the mirror: swr.cn-north-4.myhuaweicloud.com
ARG BASE_IMAGE=ascendai/pytorch:2.9.0-py3.11-ubuntu22.04-arm64-cann8.5.1

FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-pip \
        git \
        curl \
        vim \
        htop \
        tmux \
    && rm -rf /var/lib/apt/lists/*

# PyPI mirror for China
RUN pip3 config set global.index-url https://mirrors.aliyun.com/pypi/simple/ \
    && pip3 config set global.trusted-host mirrors.aliyun.com

WORKDIR /app

# Install project dependencies
COPY requirements-base.txt /app/requirements-base.txt
COPY requirements-ascend.txt /app/requirements-ascend.txt
RUN pip3 install --no-cache-dir -r requirements-base.txt \
    && pip3 install --no-cache-dir -r requirements-ascend.txt \
    && pip3 install --no-cache-dir \
        esdk-obs-python>=3.0 \
        rich \
        tqdm

# Copy project metadata only (code is hot-mounted via volume)
COPY pyproject.toml /app/pyproject.toml
RUN pip3 install --no-cache-dir -e .

# Create data directories
RUN mkdir -p /app/data/cache /app/outputs /app/logs

# Verify installation
RUN python3 -c "import torch; import torch_npu; print(f'torch={torch.__version__}, NPU available={torch.npu.is_available()}')" || echo "WARN: torch_npu verification failed"

# NPU device visibility
ENV ASCEND_VISIBLE_DEVICES=all
ENV HCCL_WHITELIST_DISABLE=1

CMD ["python3", "-m", "pytest", "-q", "--tb=short"]
