# ==================================================================
# EvoRS-Comm Docker Image - CPU only (for smoke tests, CI)
# ==================================================================
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8

# Use Chinese apt mirror for faster downloads
RUN sed -i 's|archive.ubuntu.com|mirrors.aliyun.com|g' /etc/apt/sources.list \
    && sed -i 's|security.ubuntu.com|mirrors.aliyun.com|g' /etc/apt/sources.list

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        git \
        curl \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python

WORKDIR /app

# Use Chinese PyPI mirror
RUN pip3 config set global.index-url https://mirrors.aliyun.com/pypi/simple/ \
    && pip3 config set global.trusted-host mirrors.aliyun.com

# Install all pip dependencies (the "heavy" part)
RUN pip3 install --no-cache-dir --upgrade pip \
    && pip3 install --no-cache-dir \
        pytest>=8 \
        PyYAML>=6 \
        numpy>=1.26 \
        Pillow>=10 \
        datasets>=2.19

# Code is hot-mounted via volume, not baked into the image
# PYTHONPATH lets Python find src/rs_hmcomm without pip install
ENV PYTHONPATH=/app/src

CMD ["python3", "-m", "pytest", "-q", "--tb=short"]
